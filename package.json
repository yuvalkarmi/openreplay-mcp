{
  "name": "openreplay-mcp",
  "version": "0.2.0",
  "description": "MCP server for OpenReplay session analytics over the authenticated (JWT) dashboard API — sessions, events, replays, funnels, breakdowns",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "keywords": [
    "mcp",
    "openreplay",
    "analytics",
    "sessions"
  ],
  "author": "yuvalkarmi",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "axios": "^1.16.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^25.9.1",
    "dotenv": "^17.4.2",
    "tsx": "^4.22.3",
    "typescript": "^6.0.3",
    "vitest": "^4.1.7"
  },
  "bin": {
    "openreplay-mcp": "./dist/index.js"
  }
}
