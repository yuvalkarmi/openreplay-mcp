# OpenReplay MCP configuration

# Your OpenReplay instance URL (the address you open in the browser).
# SaaS:        https://app.openreplay.com
# Self-hosted: https://or.your-domain.com
OPENREPLAY_URL=https://app.openreplay.com

# Dashboard credentials — used for JWT login (email/password).
OPENREPLAY_EMAIL=you@example.com
OPENREPLAY_PASSWORD=your_password

# Optional: default numeric project id (siteId). Call list_projects to discover it.
OPENREPLAY_PROJECT_ID=1
